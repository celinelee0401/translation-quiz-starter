{
  "name": "translation-quiz-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "deploy": "wrangler deploy",
    "check:db": "node scripts/check-migrations.mjs",
    "build:sql": "node scripts/build-setup-sql.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@electric-sql/pglite": "0.4.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "cloudflare": {
    "bindings": {
      "SCHOOL_NAME": {
        "description": "學校名稱，會顯示在網頁標題。"
      },
      "SCHOOL_CLASSES": {
        "description": "開放使用的班級與年級，格式 `班級:年級`，用逗號分隔。例如 `801:8, 802:8, 901:9`。"
      },
      "SCHOOL_YEAR": {
        "description": "目前學年，3–4 位數字，例如 `115`。"
      },
      "SCHOOL_TIMEZONE": {
        "description": "時區。台灣填 `Asia/Taipei`。"
      },
      "STUDENT_LOGIN_MODE": {
        "description": "學生登入方式：`pin`（班級＋座號＋PIN，**正式成績請選這個**）或 `seat`（只要班級＋座號，任何人都能冒用座號，只適合練習）。"
      },
      "AI_PROVIDER": {
        "description": "AI 批改建議：`none`（不用）或 `openai`（需要 OpenAI 金鑰，會產生費用）。"
      },
      "OPENAI_MODEL": {
        "description": "使用 OpenAI 時的模型名稱。不用 AI 可以不管。"
      },
      "SUPABASE_URL": {
        "description": "Supabase 專案網址：Supabase → Project Settings → Data API → **Project URL**（`https://` 開頭）。"
      },
      "SUPABASE_SECRET_KEY": {
        "description": "Supabase 的 secret key：Supabase → Project Settings → API Keys → Secret keys，按 Reveal 後複製（`sb_secret_` 開頭）。**不要**用 publishable key。"
      },
      "SETUP_CODE": {
        "description": "自己想一組至少 8 個字元的「設定碼」並記下來。部署完成後到網站的 `/setup` 頁面，用它來設定教師通行碼。"
      },
      "OPENAI_API_KEY": {
        "description": "不用 AI 就填 `none`。要用 AI 時，貼上 OpenAI 的 API key（`sk-` 開頭）。"
      }
    }
  }
}
