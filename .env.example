# 本機開發：複製成 .dev.vars（Cloudflare）後填入。正式部署用 `npx wrangler secret put <名稱>`。
# 這些都是伺服器端設定，不要放進 NEXT_PUBLIC_* 變數。

# 學年（3–4 位數字），換學年時改這裡。
SCHOOL_YEAR=115

# 學生登入方式：pin＝班級＋座號＋PIN（正式成績用）；seat＝只要班級＋座號（練習用，可被冒用）。
STUDENT_LOGIN_MODE=pin

# 學生與教師登入狀態的簽章金鑰，至少 32 個隨機字元。
TRANSLATION_SESSION_SECRET=replace-with-at-least-32-random-characters

# Supabase：Project Settings → API Keys 的 Project URL 與 secret key（sb_secret_…）。
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# AI 批改建議：none＝關閉；openai＝使用 OpenAI（需要金鑰，費用由老師自己的帳號支付）。
AI_PROVIDER=none
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-terra
